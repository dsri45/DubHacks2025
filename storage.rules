rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read/write access to skills images for authenticated users
    match /skills/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Allow read access to all images for authenticated users
    // Allow write access only to own files
    match /{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
